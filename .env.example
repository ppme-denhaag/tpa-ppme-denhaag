# Copy to .env for local dev (gitignored). Netlify's production/preview
# values are set via `netlify env:set` (see docs/github-supabase-netlify-setup-guide.md
# Part 5) — never commit real values for the SECRET-marked vars below.

# --- Client-side (Vite `VITE_` prefix = bundled into the browser build) ---
# Public by design: the anon key relies on RLS for security, not secrecy.
# Get these from Supabase dashboard > Project Settings > API.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Server-side only (Netlify Functions — never prefix with VITE_) ---
# SECRET: bypasses RLS. Never expose client-side or commit.
SUPABASE_SERVICE_ROLE_KEY=

# Web Push (VAPID). Generate one pair per environment with:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
# The public half is also needed in the browser to subscribe, so it is
# set twice under two names — same value, VITE_ prefix for the client.
# Rotating the pair invalidates every stored subscription (families have
# to re-enable notifications), so generate once per environment and keep it.
VAPID_PUBLIC_KEY=
VITE_VAPID_PUBLIC_KEY=
# SECRET
VAPID_PRIVATE_KEY=
# Contact address embedded in the VAPID JWT — a push service uses it to
# reach us if our sends misbehave. Optional; defaults to info@ppmedenhaag.nl.
# VAPID_SUBJECT=mailto:info@ppmedenhaag.nl

# SECRET: shared between Netlify and Postgres, authenticating the
# database webhook channel (migration 009). The same value must be
# stored in Supabase Vault as `notify_webhook_secret` — see README
# "Database webhooks". Generate with: openssl rand -base64 32
NOTIFY_WEBHOOK_SECRET=

# Google OAuth client — configured directly in the Supabase Auth dashboard
# (Authentication > Providers > Google), not read from app env vars. Listed
# here only as a reference for where the credentials live once created.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Phase 3 (not needed for MVP) — WhatsApp Business API reminders
# WHATSAPP_API_KEY=
