{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    // pdfkit is CommonJS with an `export =` default (see @types/pdfkit);
    // esbuild (netlify.toml's bundler) interops it at build time, this
    // makes `tsc` agree.
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": ["./**/*.mts", "./**/*.ts"]
}
